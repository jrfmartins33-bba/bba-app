# Web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Expo
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Functions / Server only
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# BBA Advisor — narrativa via Claude (Sprint 13.12). Server only, nunca
# exposta ao cliente. Sem esta chave, o Advisor continua funcionando com
# os itens template determinísticos (fallback), só não gera a narrativa.
ANTHROPIC_API_KEY=
# Opcional — sobrescreve o modelo padrão (claude-sonnet-5) sem precisar de deploy.
ANTHROPIC_ADVISOR_MODEL=

# Integração WhatsApp Cloud API — Fatia A (webhook → evidência). SERVER
# ONLY, nunca NEXT_PUBLIC_*. Nenhum valor real vai para o Git.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
# Contexto do primeiro teste (config de ambiente, nunca hardcode na lógica).
WHATSAPP_TEST_COMPANY_ID=
WHATSAPP_TEST_PROJECT_ID=
# Único remetente autorizado no primeiro teste (wa_id). Nunca commitar número real.
WHATSAPP_ALLOWED_SENDER_WA_ID=
# Profile técnico de ingresso (registered_by / uploaded_by). Criado numa ação separada.
WHATSAPP_INGEST_ACTOR_ID=
